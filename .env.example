# Copy this file to .env and fill in your API keys for local live news fetching.
# Never commit your actual .env file to version control.

# AlphaVantage API Key (https://www.alphavantage.co/support/#api-key)
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# NewsAPI Key (https://newsapi.org/register)
NEWS_API_KEY=your_newsapi_key_here

# Optional: Deployed Streamlit Community Cloud URL for GitHub Action keep-alive ping
STREAMLIT_APP_URL=
